# Template for local development. Copy to .env.local and fill in real
# values. .env.local is git-ignored; this file (.env.example) is safe to
# commit so the team knows which env vars the app needs.

# Primary synthesis model (Claude). Required.
ANTHROPIC_API_KEY=sk-ant-...
# Default model is claude-sonnet-4-6 (works on current API keys). Do NOT use
# claude-sonnet-4-20250514 unless your Anthropic account lists it — synth fails
# with 404 not_found_error while gather can still succeed (KB path skips Claude).
# ANTHROPIC_RESEARCH_MODEL=claude-sonnet-4-6

# Perplexity (Sonar live web search). Used in TWO places when set:
#   1. Freshness scout — during evidence gathering it searches the live web
#      for very recent approvals / trials / negative findings and folds them
#      into the evidence pack (tagged as web sources, verified before trust).
#   2. Cross-AI validator — the opt-in second-opinion audit of Claude's output.
# Optional but recommended. PERPLEXITY_MODEL defaults to `sonar`.
PERPLEXITY_API_KEY=pplx-...
# OPENAI_API_KEY=sk-...   # validator fallback only
# XAI_API_KEY=xai-...     # validator fallback only

# Optional: override dossier agent model (defaults to claude-sonnet-4).
# ANTHROPIC_DOSSIER_MODEL=claude-haiku-4-...
# Optional: override research synthesis model (default sonnet). If you want
# to try Opus, set this to an Opus model your Anthropic account can access.
# ANTHROPIC_RESEARCH_MODEL=claude-opus-...
# Optional: override synthesis token budget (otherwise auto-tuned by model).
# ANTHROPIC_MAX_TOKENS=1800

# Optional: re-enable the 24h persistent dossier cache. Leave unset
# during beta so the same query re-runs Claude every time (methodology
# transparency). Set to 1 once pricing matters more than integrity.
# MRT_DOSSIER_CACHE=1

# Private-preview access gate. Production and preview fail closed if this is
# absent. The frontend exchanges a passcode for an HttpOnly session cookie;
# JavaScript and localStorage never retain the passcode.
# Comma-separate multiple passcodes so any single one can be revoked
# without rotating the others (e.g. one for Dorothy, one for Tim).
# MRT_ACCESS_PASSCODE=dorothy-2026-spring,tim-2026-spring,hammad-rotating
# Separate reviewer credential for global error-memory corrections. This is
# never an ordinary preview passcode. Generate with: openssl rand -hex 32
# MRT_REVIEWER_TOKEN=
# Optional dedicated Terms-cookie signing secret. If omitted, the access
# passcode signs Terms acceptance, so rotating passcodes requires reacceptance.
# MRT_TERMS_SIGNING_SECRET=
# Dedicated report-export seal root key. Required in production and preview;
# never reuse access, Terms, cron, or reviewer credentials. Generate separately:
# openssl rand -hex 32
# MRT_REPORT_SEAL_SECRET=
# Operator-only demo commands (set in the shell; do not persist credentials):
# npm run demo:smoke
# MRT_BASE_URL=https://... MRT_EXPECTED_SHA=<full-reviewed-sha> \
#   MRT_DEMO_ACCESS_PASSCODE=<one-operator-code> npm run demo:preflight
# Optional bounded network behavior (defaults: 10s, 2 attempts; max 3 attempts):
# MRT_DEMO_TIMEOUT_MS=10000
# MRT_DEMO_ATTEMPTS=2
# Explicitly allow one paid production golden-profile report (off by default):
# MRT_DEMO_PRODUCTION=1
# MRT_DEMO_ALLOW_PAID=1
# Optional additional browser origins (comma-separated). Same-origin is always allowed.
# MRT_ALLOWED_ORIGINS=https://researchingmycondition.com

# Optional: override the gather-phase deadline (ms). Defaults to 90s
# now that we're on Vercel Pro (300s function cap). Was 48s on Hobby.
# MRT_GATHER_DEADLINE_MS=90000

# Local dev only — skip monthly run limits (vercel dev also auto-disables when VERCEL_ENV=development)
# MRT_SKIP_USAGE_LIMIT=1

# Monetization / usage limits (per-IP monthly caps).
# MRT_FREE_LIMIT=4
# Pro tier (backward compat: MRT_PAID_* maps to Pro)
# MRT_PRO_PRICE_USD=20
# MRT_PRO_LIMIT=100
# MRT_PRO_CODES=PRO-CODE-1,PRO-CODE-2
# MRT_PAID_LIMIT=100
# MRT_PAID_PRICE_USD=20
# MRT_PAID_CODES=YOUR-CODE-1,YOUR-CODE-2
# Max tier
# MRT_MAX_PRICE_USD=79
# MRT_MAX_LIMIT=500
# MRT_MAX_CODES=MAX-CODE-1,MAX-CODE-2
# MRT_PAID_IPS=203.0.113.7,198.51.100.13
# Optional operator-approved checkout link. Only absolute https:// URLs without
# credentials, control characters, or encoded whitespace are exposed or linked.
# MRT_UPGRADE_URL=https://buy.stripe.com/...

# Ads runtime toggles (optional).
# MRT_ADS_ENABLED=1
# MRT_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# MRT_AD_SLOT_RESEARCH_TOP=1234567890
# MRT_AD_SLOT_REPURPOSE_TOP=1234567891
# MRT_AD_SLOT_TRIALS_TOP=1234567892
# MRT_AD_SLOT_FOOTER=1234567893

# Persistent brain (Upstash Redis). Required in production — without these,
# dynamic KBs, daily refresh overlays, usage limits, and alert subs reset
# on every cold start. Free tier at upstash.com → REST API tab.
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=AX...

# Secures /api/brain-cron and /api/alerts-cron. Vercel sends this on
# scheduled crons. Generate: openssl rand -hex 32
# CRON_SECRET=
# Production alert delivery is fail-closed unless all four are configured.
# RESEND_API_KEY=re_...
# ALERTS_EMAIL_FROM=Medical Research Alerts <alerts@researchingmycondition.com>
# ALERTS_PUBLIC_URL=https://researchingmycondition.com
# ALERTS_MONITOR_WEBHOOK_URL=https://monitor.example/hooks/...

# Dynamic KB + daily brain refresh (defaults on).
# MRT_DYNAMIC_KB=1
# MRT_BRAIN_CRON=1
# MRT_BRAIN_REFRESH_HOURS=24

# Smart condition intake — typo repair, ontology, gene notation (RP26/CERKL),
# subtype dropdown, and silent rename when you hit Search. Default ON.
# NOT a money saver (these are local). Use spend switches below for API cost.
# MRT_CONDITION_INFERENCE=0
# MRT_CONDITION_SUBTYPE_PICKER=0

# --- Spend kill switches (stop API charges) ---
# Master off: no Anthropic/Perplexity on user runs (chat, translate, research).
# MRT_SPEND_ENABLED=0
# Narrow: block Search / Run research only (~$0.05–0.75 per run).
# MRT_RESEARCH_ENABLED=0
# Perplexity only (validation + live web scout). Anthropic still runs.
# MRT_PERPLEXITY_ENABLED=0
# Background costs (no user click):
# MRT_DYNAMIC_KB=0
# MRT_BRAIN_CRON=0
# Cap free runs per IP (set MRT_DISABLE_USAGE_LIMIT=0 to enforce):
# MRT_FREE_LIMIT=4
# MRT_DISABLE_USAGE_LIMIT=0
# Cache dossier calls for repeat conditions:
# MRT_DOSSIER_CACHE=1
