# Server-only. Do not prefix these with VITE_.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENALEX_API_KEY=
# Optional: expands discovery to the broader public web. Results are shown as
# links only until a supported source independently verifies a clinical claim.
PERPLEXITY_API_KEY=
# Optional: a higher Semantic Scholar API quota when configured.
SEMANTIC_SCHOLAR_API_KEY=

# Private-demo access. This is checked by the server and stored in an HttpOnly
# session cookie. Use a long private passcode and never expose it as VITE_.
SITE_ACCESS_PASSCODE=
# Set to true for Vercel or any HTTPS deployment. Keep false for local HTTP.
SITE_ACCESS_SECURE_COOKIE=false
# Required for Vercel or other serverless deployments. Use at least 32 random
# characters; this signs the HttpOnly access session without exposing the passcode.
SITE_ACCESS_SESSION_SECRET=

# Optional provider overrides.
ANTHROPIC_RESEARCH_MODEL=claude-sonnet-4-6
OPENAI_REVIEW_MODEL=gpt-5
