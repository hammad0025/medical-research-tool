# Template for local development. Copy to .env.local and fill in real
# values. .env.local is git-ignored; this file (.env.example) is safe to
# commit so the team knows which env vars the app needs.

# Primary synthesis model (Claude). Required.
ANTHROPIC_API_KEY=sk-ant-...

# Cross-AI validator. Perplexity is preferred — it runs an independent
# Sonar web search over Claude's output + evidence pack and flags
# citations that don't resolve or claims that aren't grounded.
# Setting any one of these turns on the validator.
PERPLEXITY_API_KEY=pplx-...
# OPENAI_API_KEY=sk-...
# XAI_API_KEY=xai-...

# Optional: override dossier agent model (defaults to claude-sonnet-4).
# ANTHROPIC_DOSSIER_MODEL=claude-haiku-4-...
# Optional: override research synthesis model (default sonnet). If you want
# to try Opus, set this to an Opus model your Anthropic account can access.
# ANTHROPIC_RESEARCH_MODEL=claude-opus-...
# Optional: override synthesis token budget (otherwise auto-tuned by model).
# ANTHROPIC_MAX_TOKENS=1800

# Optional: re-enable the 24h persistent dossier cache. Leave unset
# during beta so the same query re-runs Claude every time (methodology
# transparency). Set to 1 once pricing matters more than integrity.
# MRT_DOSSIER_CACHE=1

# Monetization / usage limits (per-IP monthly caps).
# MRT_FREE_LIMIT=4
# MRT_PAID_LIMIT=15
# MRT_PAID_PRICE_USD=10
# MRT_PAID_CODES=YOUR-CODE-1,YOUR-CODE-2
# MRT_PAID_IPS=203.0.113.7,198.51.100.13
# MRT_UPGRADE_URL=https://buy.stripe.com/...

# Ads runtime toggles (optional).
# MRT_ADS_ENABLED=1
# MRT_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# MRT_AD_SLOT_RESEARCH_TOP=1234567890
# MRT_AD_SLOT_REPURPOSE_TOP=1234567891
# MRT_AD_SLOT_TRIALS_TOP=1234567892
# MRT_AD_SLOT_FOOTER=1234567893
