{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "check": "npm run lint && npm test",
    "lint": "oxlint",
    "test": "node --test && python3 scripts/testLincsGctxExporter.py && python3 scripts/testAwsTranscriptomicBatchWorker.py && python3 scripts/testAwsInfrastructure.py",
    "test:matrix": "node --test --test-name-pattern='ten-condition report matrix'",
    "test:stress": "node --test --test-name-pattern='fifteen-condition stress matrix'",
    "worker:geo": "node scripts/geoSignatureIngestionWorker.mjs",
    "worker:lincs": "node scripts/lincsSignatureIngestionWorker.mjs",
    "worker:transcriptomic": "node scripts/transcriptomicInversionWorker.mjs",
    "verify:deployment": "node scripts/deploymentVerifier.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
